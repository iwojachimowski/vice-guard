{
  "name": "vice-guard",
  "version": "2.0.0",
  "private": true,
  "description": "High-recall local GTA VI spoiler blocker for Chromium",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run assets && wxt",
    "build": "npm run assets && wxt build",
    "zip": "npm run assets && wxt zip",
    "assets": "jiti scripts/copy-assets.ts",
    "model": "jiti scripts/clip-prompts.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "eval": "jiti tests/eval/run.ts",
    "eval:dataset": "jiti tests/eval/build-dataset.ts",
    "eval:images": "jiti tests/eval/images.ts",
    "postinstall": "wxt prepare",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
